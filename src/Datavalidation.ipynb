#!/usr/bin/env python3
import pathlib
import pandas as pd
from datetime import datetime
from typing import Optional

# ----------------------------------------------------------------------
# CONFIGURATION
# ----------------------------------------------------------------------
INPUT_DIR    = pathlib.Path("/Users/tanmasleigh/Documents/Projects/GAMMA/Data/")  # Change if your files are elsewhere
OUTPUT_FILE  = pathlib.Path("/Users/tanmasleigh/Documents/Projects/GAMMA/Data/EURUSD_M1_2012_2023.csv")
FILE_PATTERN  = "DAT_ASCII_EURUSD_M1_*.csv"  # Matches your filenames

# ----------------------------------------------------------------------
# HELPER: Parse one line (handles BOTH ; and , separators)
# ----------------------------------------------------------------------
def parse_line(line: str) -> Optional[dict]:
    line = line.strip()
    if not line:
        return None

    # Auto-detect delimiter: ; or ,
    if ';' in line:
        parts = [p.strip() for p in line.split(';')]
        expected = "semicolon"
    elif ',' in line:
        parts = [p.strip() for p in line.split(',')]
        expected = "comma"
    else:
        raise ValueError(f"No delimiter found in line: {line!r}")

    if len(parts) != 6:
        raise ValueError(f"Expected 6 fields ({expected}), got {len(parts)}: {line!r}")

    date_time_str, o, h, l, c, v = parts

    # Split "20120102 020000" → date and time
    try:
        date_part, time_part = date_time_str.split()
    except ValueError:
        raise ValueError(f"Cannot split date/time: {date_time_str!r} in {line!r}")

    # Build ISO datetime string
    dt_str = (
        f"{date_part[:4]}-{date_part[4:6]}-{date_part[6:8]} "
        f"{time_part[:2]}:{time_part[2:4]}:{time_part[4:6]}"
    )

    try:
        dt = datetime.strptime(dt_str, "%Y-%m-%d %H:%M:%S")
    except ValueError as e:
        raise ValueError(f"Invalid datetime format: {dt_str!r} from {line!r}") from e

    return {
        "Datetime": dt,
        "Open":     float(o),
        "High":     float(h),
        "Low":      float(l),
        "Close":    float(c),
        "Volume":   float(v),
    }

# ----------------------------------------------------------------------
# MAIN: Merge all files
# ----------------------------------------------------------------------
def main():
    # Find and sort files by year
    files = sorted(
        INPUT_DIR.glob(FILE_PATTERN),
        key=lambda p: p.stem.split("_")[-1]
    )

    if not files:
        raise FileNotFoundError(f"No files found matching '{FILE_PATTERN}' in {INPUT_DIR}")

    print(f"Found {len(files)} files: {', '.join(f.stem[-4:] for f in files)}")

    dfs = []
    for filepath in files:
        print(f"Processing {filepath.name} ...")
        rows = []

        with filepath.open("r", encoding="utf-8") as f:
            for raw_line in f:
                parsed = parse_line(raw_line)
                if parsed:
                    rows.append(parsed)

        if not rows:
            print(f"  Warning: No valid rows in {filepath.name}")
            continue

        df = pd.DataFrame(rows)
        dfs.append(df)

    if not dfs:
        raise ValueError("No data was parsed from any file!")

    # Combine all years
    full_df = pd.concat(dfs, ignore_index=True)
    full_df = full_df.sort_values("Datetime").reset_index(drop=True)

    # Save with clean formatting
    full_df.to_csv(OUTPUT_FILE, index=False, float_format="%.5f")
    print(f"\nDone! Merged file saved to:")
    print(f"  {OUTPUT_FILE.resolve()}")
    print(f"  Total rows: {len(full_df):,}")

# ----------------------------------------------------------------------
# RUN
# ----------------------------------------------------------------------
if __name__ == "__main__":
    main()
    Data validation.ipynb